{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gainsec.internal/schemas/verkeye-ir-v1.schema.json",
  "title": "VerkEye provenance-preserving intermediate representation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "graph", "gates"],
  "properties": {
    "schema": {"const": "verkeye.ir.v1"},
    "source": {"$ref": "#/$defs/source"},
    "graph": {"$ref": "#/$defs/graph"},
    "gates": {
      "type": "array",
      "items": {"$ref": "#/$defs/gate"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "disposition": {
      "enum": ["exact", "inferred", "unknown"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha256",
        "offset",
        "size",
        "end",
        "disposition",
        "evidence"
      ],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "offset": {"type": "integer", "minimum": 0},
        "size": {"type": "integer", "minimum": 1},
        "end": {"type": "integer", "minimum": 1},
        "disposition": {"$ref": "#/$defs/disposition"},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "provenanceList": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/provenance"}
    },
    "attributeValue": {
      "anyOf": [
        {"type": "string"},
        {"type": "integer"},
        {"type": "number"},
        {"type": "boolean"},
        {"type": "null"},
        {
          "type": "array",
          "items": {
            "anyOf": [
              {"type": "string"},
              {"type": "integer"},
              {"type": "number"},
              {"type": "boolean"},
              {"type": "null"}
            ]
          }
        }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "operator",
        "inputs",
        "outputs",
        "attributes",
        "disposition",
        "provenance"
      ],
      "properties": {
        "identifier": {"type": "string", "minLength": 1},
        "operator": {"type": "string", "minLength": 1},
        "inputs": {"type": "array", "items": {"type": "string"}},
        "outputs": {"type": "array", "items": {"type": "string"}},
        "attributes": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/attributeValue"}
        },
        "disposition": {"$ref": "#/$defs/disposition"},
        "provenance": {"$ref": "#/$defs/provenanceList"}
      }
    },
    "quantization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scale",
        "zero_point",
        "dtype",
        "disposition",
        "provenance"
      ],
      "properties": {
        "scale": {
          "oneOf": [
            {"type": "null"},
            {"type": "number"},
            {"type": "array", "items": {"type": "number"}}
          ]
        },
        "zero_point": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer"},
            {"type": "array", "items": {"type": "integer"}}
          ]
        },
        "dtype": {"type": ["string", "null"]},
        "disposition": {"$ref": "#/$defs/disposition"},
        "provenance": {"$ref": "#/$defs/provenanceList"}
      }
    },
    "tensor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "name",
        "role",
        "shape",
        "pitch",
        "pitch_byte_offset",
        "pitch_bit_size",
        "dram_format",
        "bitvector",
        "storage_dtype",
        "exponent_offset",
        "exponent_bits",
        "buffer_extent",
        "disposition",
        "provenance",
        "quantization"
      ],
      "properties": {
        "identifier": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "role": {"enum": ["input", "output"]},
        "shape": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 1}
        },
        "pitch": {"type": "integer", "minimum": 1},
        "pitch_byte_offset": {"type": "integer", "minimum": 0},
        "pitch_bit_size": {"type": "integer", "minimum": 0, "maximum": 63},
        "dram_format": {"type": "integer", "minimum": 0, "maximum": 15},
        "bitvector": {"type": "boolean"},
        "storage_dtype": {
          "enum": ["uint8", "int8", "uint16", "int16", "uint32", "int32", "uint64", "int64"]
        },
        "exponent_offset": {"type": "integer", "minimum": -128, "maximum": 127},
        "exponent_bits": {"type": "integer", "minimum": 0, "maximum": 255},
        "buffer_extent": {"type": "integer", "minimum": 1},
        "disposition": {"$ref": "#/$defs/disposition"},
        "provenance": {"$ref": "#/$defs/provenanceList"},
        "quantization": {"$ref": "#/$defs/quantization"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "producer",
        "consumer",
        "evidence",
        "disposition",
        "provenance"
      ],
      "properties": {
        "identifier": {"type": "string", "minLength": 1},
        "producer": {"type": "string", "minLength": 1},
        "consumer": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1},
        "disposition": {"$ref": "#/$defs/disposition"},
        "provenance": {"$ref": "#/$defs/provenanceList"}
      }
    },
    "constant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "dtype",
        "shape",
        "data_hex",
        "disposition",
        "provenance"
      ],
      "properties": {
        "identifier": {"type": "string", "minLength": 1},
        "dtype": {"type": ["string", "null"]},
        "shape": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "items": {"type": "integer", "minimum": 1}
            }
          ]
        },
        "data_hex": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^(?:[0-9a-f]{2})*$"}
          ]
        },
        "disposition": {"$ref": "#/$defs/disposition"},
        "provenance": {"$ref": "#/$defs/provenanceList"}
      }
    },
    "opaqueRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "kind",
        "sha256",
        "disposition",
        "provenance"
      ],
      "properties": {
        "identifier": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "disposition": {"$ref": "#/$defs/disposition"},
        "provenance": {"$ref": "#/$defs/provenanceList"}
      }
    },
    "programRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "split_index",
        "kind",
        "sha256",
        "disposition",
        "provenance"
      ],
      "properties": {
        "identifier": {"type": "string", "minLength": 1},
        "split_index": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["opaque_hardware_image", "compiler_footer"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "disposition": {"$ref": "#/$defs/disposition"},
        "provenance": {"$ref": "#/$defs/provenanceList"}
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "tensors",
        "edges",
        "constants",
        "opaque_regions",
        "program_regions",
        "external_inputs",
        "external_outputs"
      ],
      "properties": {
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
        "tensors": {"type": "array", "items": {"$ref": "#/$defs/tensor"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
        "constants": {
          "type": "array",
          "items": {"$ref": "#/$defs/constant"}
        },
        "opaque_regions": {
          "type": "array",
          "items": {"$ref": "#/$defs/opaqueRegion"}
        },
        "program_regions": {
          "type": "array",
          "items": {"$ref": "#/$defs/programRegion"}
        },
        "external_inputs": {"type": "array", "items": {"type": "string"}},
        "external_outputs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "reason_codes"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["passed", "blocked", "failed"]},
        "reason_codes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
