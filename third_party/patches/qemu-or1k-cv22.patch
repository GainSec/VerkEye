+static Cv22DvpRegister *cv22_dvp_register(CPUOpenRISCState *env,
+                                         uint32_t address, bool allocate)
+{
+    Cv22DvpRegister *free_slot = NULL;
+    int index;
+
+    for (index = 0; index < CV22_DVP_REGISTER_COUNT; index++) {
+        Cv22DvpRegister *entry = &env->cv22_dvp_registers[index];
+
+        if (entry->valid && entry->address == address) {
+            return entry;
+        }
+        if (!entry->valid && free_slot == NULL) {
+            free_slot = entry;
+        }
+    }
+    if (allocate && free_slot != NULL) {
+        free_slot->address = address;
+        free_slot->valid = true;
+        return free_slot;
+    }
+    return NULL;
+}
+
+void HELPER(cv22_dvp_write)(CPUOpenRISCState *env, uint32_t address,
+                            uint32_t value)
+{
+    OpenRISCCPU *cpu = env_archcpu(env);
+    Cv22DvpRegister *entry;
+
+    if (!env->cv22_extensions || (address & 3)) {
+        raise_exception(cpu, EXCP_ILLEGAL);
+    }
+    entry = cv22_dvp_register(env, address, true);
+    if (entry == NULL) {
+        raise_exception(cpu, EXCP_ILLEGAL);
+    }
+    entry->value = value;
+}
+
+void HELPER(cv22_dvp_read)(CPUOpenRISCState *env, uint32_t address)
+{
+    OpenRISCCPU *cpu = env_archcpu(env);
+    Cv22DvpRegister *entry;
+
+    if (!env->cv22_extensions || (address & 3)) {
+        raise_exception(cpu, EXCP_ILLEGAL);
+    }
+    entry = cv22_dvp_register(env, address, false);
+    if (entry == NULL) {
+        raise_exception(cpu, EXCP_ILLEGAL);
+    }
+    env->cv22_dvp_read_latch = entry->value;
+}
+
