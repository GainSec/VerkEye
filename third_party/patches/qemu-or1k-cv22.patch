                       | (IMMUCFGR_NTS & (ctz32(TLB_SIZE) << 2));
 }

+/*
+ * Local CV22 compatibility model.
+ *
+ * The recovered Ambarella scheduler is compiled for an OpenRISC core with
+ * CPUCFGR.ND set.  Keep this model separate from the architectural "any"
+ * model so the diagnostic compatibility work does not change established
+ * QEMU CPU behavior.
+ */
+static void ambarella_cv22_initfn(Object *obj)
+{
+    OpenRISCCPU *cpu = OPENRISC_CPU(obj);
+
+    openrisc_any_initfn(obj);
+    cpu->env.cpucfgr |= CPUCFGR_ND;
+    cpu->env.cv22_extensions = true;
+}
+
 #ifndef CONFIG_USER_ONLY
 #include "hw/core/sysemu-cpu-ops.h"

@@ -319,6 +336,7 @@ static const TypeInfo openrisc_cpus_type_infos[] = {
     },
     DEFINE_OPENRISC_CPU_TYPE("or1200", or1200_initfn),
     DEFINE_OPENRISC_CPU_TYPE("any", openrisc_any_initfn),
+    DEFINE_OPENRISC_CPU_TYPE("ambarella-cv22", ambarella_cv22_initfn),
 };

 DEFINE_TYPES(openrisc_cpus_type_infos)
